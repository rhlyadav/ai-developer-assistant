# Gemini OpenAI-compatible chat-completions API. Get a key from Google AI Studio.
# Keep the real key in .env only.
LLM_API_KEY=replace-with-your-gemini-api-key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-2.5-flash

# Comma-separated origins permitted to call this API.
CORS_ORIGINS=http://localhost:5173
